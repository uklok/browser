#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${root}/.venv/bin/python"

if [[ ! -x "${python}" ]]; then
  echo "ERROR: repo-local environment is not ready." >&2
  echo "Run: ${root}/bin/browser-use-setup" >&2
  exit 1
fi

exec "${python}" "${root}/automations/_runtime/cli.py" "$@"
