# Published image used by the base deployment.
# Prefer an immutable semver or sha-* tag for production.
BROWSER_IMAGE=ghcr.io/uklok/browser:edge

# Used only when bind-profile.yaml is included.
BROWSER_PROFILE_PATH=${HOME}/.chrome-upwork-cdp

NOVNC_HOST_PORT=6080
CDP_HOST_PORT=9222

SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
SCREEN_DEPTH=24

CHROME_START_URL=about:blank
CHROME_EXTRA_ARGS=
CHROME_DISABLE_SANDBOX=0

# Optional. Network isolation remains the primary security boundary.
# Legacy VNC authentication has protocol limitations; do not expose noVNC publicly.
VNC_PASSWORD=
