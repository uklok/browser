# Published image used by the base deployment.
# Prefer an immutable semver or sha-* tag for production.
BROWSER_IMAGE=ghcr.io/uklok/browser:edge

# Google Chrome for Linux is distributed by this image as amd64.
# Docker Desktop on Apple Silicon uses emulation for this platform.
BROWSER_PLATFORM=linux/amd64

# Used only when bind-profile.yaml is included.
# This must be a directory owned exclusively by the Linux container browser.
# Do not point it at a macOS/Windows Chrome user-data-dir.
BROWSER_PROFILE_PATH=${HOME}/.uklok-browser/chrome-profile
BROWSER_PROFILE_ADOPT_EXISTING=0

NOVNC_HOST_PORT=6080
CDP_HOST_PORT=9222

SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
SCREEN_DEPTH=24

CHROME_START_URL=about:blank
CHROME_EXTRA_ARGS=
CHROME_DISABLE_SANDBOX=0

# local.yaml only: try sandboxed Chrome first, then retry with --no-sandbox
# only when Docker Desktop/emulation rejects Chrome's namespace setup.
LOCAL_CHROME_ALLOW_SANDBOX_FALLBACK=1

# Optional. Network isolation remains the primary security boundary.
# Legacy VNC authentication has protocol limitations; do not expose noVNC publicly.
VNC_PASSWORD=
